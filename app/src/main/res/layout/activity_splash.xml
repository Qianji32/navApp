<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Center content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Logo plate -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="28dp">

            <!-- Glow ring -->
            <View
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_ar_fab"
                android:alpha="0.15" />

            <!-- Logo background -->
            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ar_fab" />

            <!-- Building icon -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_3d_building"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IndoorNav"
            android:textColor="#F0F6FF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tagline"
            android:textColor="#93C5FD"
            android:textSize="14sp"
            android:letterSpacing="0.06" />

        <!-- Decorative line -->
        <View
            android:layout_width="80dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#4D3B82F6" />

        <!-- Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="v1.0.0"
            android:textColor="#60A5FA"
            android:textSize="11sp"
            android:alpha="0.6"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Bottom loading bar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="60dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/splash_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="100dp"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:indeterminateTint="#60A5FA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loading…"
            android:textColor="#60A5FA"
            android:textSize="11sp"
            android:alpha="0.7"
            android:letterSpacing="0.03" />
    </LinearLayout>

</FrameLayout>
