<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/gl_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.indoornavapp.ui.view.LabelOverlayView
        android:id="@+id/label_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_back_3d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="top|start"
        android:src="@android:drawable/ic_menu_revert"
        app:backgroundTint="@color/white"
        app:tint="@color/gray_800"
        app:fabSize="mini" />

    <!-- Floor selector -->
    <LinearLayout
        android:id="@+id/floor_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:elevation="6dp"
        android:padding="4dp"
        android:background="#BBFFFFFF" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#CCFFFFFF"
        android:orientation="horizontal"
        android:padding="12dp">

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="#8CD0F2" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:text="Room"
            android:textSize="11sp" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="#D95CA6" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:text="Stairs"
            android:textSize="11sp" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="#40D9D9" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:text="Elevator"
            android:textSize="11sp" />

        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="#40D973" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Exit"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="#CCFFFFFF"
        android:padding="8dp"
        android:text="3D Indoor Map · Drag to rotate · Pinch to zoom"
        android:textColor="@color/gray_800"
        android:textSize="12sp" />

</FrameLayout>
